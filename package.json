{
  "name": "front-ouaknine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    ">0.3%",
    "not ie 11",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "next lint --dir pages --dir components --dir libs --dir hooks --dir context",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "yarn biome:check && yarn lint && yarn typecheck && yarn test"
  },
  "dependencies": {
    "@heroicons/react": "1.0.6",
    "@portabletext/react": "1.0.6",
    "next": "12.3.1",
    "next-sanity": "0.6.0",
    "next-sanity-image": "4.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@next/eslint-plugin-next": "12.3.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.21.0",
    "sass": "1.54.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
